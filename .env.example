# Enerza API base URL, including /api/v1. Only the Next.js server calls it.
API_URL=http://localhost:5000/api/v1

# Same value as INTERNAL_API_KEY in the API's .env. Lets the API apply rate
# limits and audit logs per visitor instead of per frontend server.
INTERNAL_API_KEY=

# Optional. Same value as JWT_ACCESS_SECRET in the API's .env. When set, the
# proxy verifies the access token's signature before letting a request into a
# protected route; without it the token is only decoded and its expiry checked.
JWT_ACCESS_SECRET=

# One-click demo logins. These never reach the browser: the login runs on the server.
DEMO_ADMIN_EMAIL=admin@enerza.com
DEMO_ADMIN_PASSWORD=
DEMO_TECHNICIAN_EMAIL=tech.north@enerza.com
DEMO_TECHNICIAN_PASSWORD=Enerza@12345
DEMO_CUSTOMER_EMAIL=customer1@enerza.com
DEMO_CUSTOMER_PASSWORD=Enerza@12345

# Optional. Google OAuth client id (the same one the API verifies ID tokens
# against). Shows "Continue with Google" on the login page when set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Gmail SMTP for the contact form. Without these the form reports
# that messaging is not configured.
SMTP_USER=
SMTP_PASSWORD=
CONTACT_INBOX=
